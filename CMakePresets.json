{
  "version": 3,
  "configurePresets": [
    {"name": "release", "generator": "Ninja", "binaryDir": "${sourceDir}/build", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "tsan", "inherits": "debug", "binaryDir": "${sourceDir}/build-tsan", "cacheVariables": {"ENABLE_TSAN": "ON", "ENABLE_OPENMP": "OFF"}}
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "debug", "configurePreset": "debug"},
    {"name": "tsan", "configurePreset": "tsan"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}}
  ]
}
